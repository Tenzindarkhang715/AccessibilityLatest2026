abi <abi/5.0>,
include <tunables/global>

# Chromium is already isolated by the scanner network, mount/PID namespaces,
# cgroup limits, UID 61001, empty capabilities and NoNewPrivs=1. Ubuntu 23.10+
# additionally requires an AppArmor userns grant for Chromium's own sandbox.
# The production launcher enters this profile before enabling no_new_privs.
profile accessibility-scanner-chrome /opt/scanner-runtime/chromium-1243/chrome-linux-arm64/chrome flags=(unconfined) {
  userns,
  @{exec_path} mr,
}
